  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
