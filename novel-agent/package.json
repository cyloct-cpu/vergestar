{
  "name": "@vergestar/novel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:inkos-core": "npm --prefix vendor/inkos-core run build",
    "build": "npm run build:inkos-core && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
